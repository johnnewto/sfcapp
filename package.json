{
  "name": "sfcr-workspace",
  "private": true,
  "packageManager": "pnpm@10.8.0",
  "scripts": {
    "build": "pnpm --filter @sfcr/core build && pnpm --filter @sfcr/web build",
    "dev": "pnpm web:dev",
    "eval:chat-builder": "pnpm --filter @sfcr/web run eval:chat-builder",
    "eval:chat-builder:live": "pnpm --filter @sfcr/web run eval:chat-builder:live",
    "lint": "turbo run lint && pnpm deadcode",
    "deadcode": "knip",
    "deadcode:fix": "knip --fix",
    "menu": "node scripts/dev-menu.mjs",
    "files:report": "rg --files packages | rg '\\.(ts|tsx)$' | xargs wc -l | sort -n",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "web:dev": "pnpm --filter @sfcr/web dev",
    "web:build": "pnpm --filter @sfcr/web build",
    "web:test:fast": "pnpm --filter @sfcr/web run test:fast",
    "web:test:integration": "pnpm --filter @sfcr/web exec vitest run test/App.notebook-source.test.tsx test/App.notebook-cell-editors.test.tsx test/App.notebook-navigation.test.tsx test/App.notebook-assistant.test.tsx",
    "web:test:templates": "pnpm --filter @sfcr/web run test:templates",
    "web:bench:gl8-growth": "pnpm --filter @sfcr/web run bench:gl8-growth",
    "web:compile:notebook-yaml": "pnpm --filter @sfcr/web compile:notebook-yaml -- --write",
    "web:compile:notebook-yaml:public": "pnpm --filter @sfcr/web compile:notebook-yaml -- --write --write-public-examples",
    "web:preview": "pnpm --filter @sfcr/web exec vite preview --port 4173",
    "web:build:pages": "VITE_BASE_PATH=/moneyjs/ pnpm --filter @sfcr/web build",
    "web:build:cloudflare": "VITE_BASE_PATH=/ pnpm --filter @sfcr/web build",
    "web:preview:pages": "pnpm web:build:pages && node ./scripts/preview-pages.mjs"
  },
  "devDependencies": {
    "knip": "^6.20.0",
    "turbo": "^2.5.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
